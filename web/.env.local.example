# =============================================================================
# TenderIQ Web — copy to web/.env.local
# =============================================================================
# run.bat syncs API URL from root .env; keep AUTH_PROVIDER in sync with root.
# =============================================================================

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_PROVIDER=local
# Browser uses same-origin /api/v1 proxy (avoids CORS). Set 0 to call API URL directly.
NEXT_PUBLIC_USE_API_PROXY=1

NEXT_PUBLIC_FEATURE_AI_ANALYSIS=true
NEXT_PUBLIC_FEATURE_DOCUMENT_OCR=false
NEXT_PUBLIC_FEATURE_ADVANCED_ANALYTICS=false
NEXT_PUBLIC_FEATURE_SSO=false
