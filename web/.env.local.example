# =============================================================================
# TenderIQ Web — copy to web/.env.local
# =============================================================================
# Must match root .env: NEXT_PUBLIC_* and auth provider
# Setup:  copy .env.local.example .env.local
# =============================================================================

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_PROVIDER=local

# Supabase (when AUTH_PROVIDER=supabase in root .env)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clerk (when AUTH_PROVIDER=clerk in root .env)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

NEXT_PUBLIC_FEATURE_AI_ANALYSIS=true
NEXT_PUBLIC_FEATURE_DOCUMENT_OCR=false
NEXT_PUBLIC_FEATURE_ADVANCED_ANALYTICS=false
NEXT_PUBLIC_FEATURE_SSO=false
