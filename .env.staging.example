# ===========================================
# TENDERIQ - STAGING ENVIRONMENT
# ===========================================
# Copy to .env.staging and update values

# ===========================================
# APP
# ===========================================
NODE_ENV=staging
LOG_LEVEL=info
APP_NAME=TenderIQ
APP_URL=https://staging.tendoriq.app

# ===========================================
# DATABASE - PostgreSQL (Railway)
# ===========================================
DATABASE_URL=${DATABASE_URL}
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ===========================================
# REDIS (Railway)
# ===========================================
REDIS_URL=${REDIS_URL}

# ===========================================
# AUTH - Clerk
# ===========================================
AUTH_PROVIDER=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxx
CLERK_SECRET_KEY=${CLERK_SECRET_KEY}
CLERK_WEBHOOK_SECRET=${CLERK_WEBHOOK_SECRET}
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# JWT - Use strong secret in production
JWT_SECRET=${JWT_SECRET}
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# API - FastAPI
# ===========================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_WORKERS=2
API_CORS_ORIGINS=https://staging.tendoriq.app
API_PREFIX=/api/v1

# ===========================================
# FRONTEND - Next.js
# ===========================================
NEXT_PUBLIC_APP_URL=https://staging.tendoriq.app
NEXT_PUBLIC_API_URL=https://staging-api.tendoriq.app
NEXT_PUBLIC_APP_NAME=TenderIQ

# ===========================================
# STORAGE - Cloudflare R2
# ===========================================
STORAGE_PROVIDER=r2
AWS_REGION=auto
AWS_S3_BUCKET=tendoriq-staging
AWS_ACCESS_KEY_ID=${R2_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${R2_SECRET_ACCESS_KEY}
AWS_ENDPOINT_URL=${R2_ENDPOINT_URL}

# ===========================================
# AI - OpenAI
# ===========================================
AI_PROVIDER=openai
AI_API_KEY=${OPENAI_API_KEY}
AI_MODEL=gpt-4-turbo
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7

# ===========================================
# EMAIL - Resend
# ===========================================
EMAIL_PROVIDER=resend
EMAIL_API_KEY=${RESEND_API_KEY}
EMAIL_FROM=noreply@staging.tendoriq.app
EMAIL_FROM_NAME=TenderIQ Staging

# ===========================================
# OBSERVABILITY - Sentry
# ===========================================
SENTRY_DSN=${SENTRY_DSN}
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.5
SENTRY_PROFILING_SAMPLE_RATE=0.1

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=2000

# ===========================================
# FEATURE FLAGS
# ===========================================
FEATURE_AI_ANALYSIS=true
FEATURE_DOCUMENT_OCR=false
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_WEBHOOKS=true
FEATURE_API_ACCESS=true
FEATURE_CUSTOM_DOMAINS=false
FEATURE_SSO=false