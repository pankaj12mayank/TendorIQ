# ===========================================
# TENDERIQ - PRODUCTION ENVIRONMENT
# ===========================================
# Copy to .env.production and update values

# ===========================================
# APP
# ===========================================
NODE_ENV=production
LOG_LEVEL=warn
APP_NAME=TenderIQ
APP_URL=https://tendoriq.com

# ===========================================
# DATABASE - PostgreSQL (Railway/Supabase)
# ===========================================
DATABASE_URL=${DATABASE_URL}
DATABASE_POOL_SIZE=30
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# ===========================================
# REDIS (Railway/Upstash)
# ===========================================
REDIS_URL=${REDIS_URL}

# ===========================================
# AUTH - Clerk (PRODUCTION KEYS)
# ===========================================
AUTH_PROVIDER=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxx
CLERK_SECRET_KEY=${CLERK_SECRET_KEY}
CLERK_WEBHOOK_SECRET=${CLERK_WEBHOOK_SECRET}
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# JWT - MUST BE STRONG SECRET (64+ chars recommended)
JWT_SECRET=${JWT_SECRET}
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# API - FastAPI
# ===========================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_WORKERS=4
API_CORS_ORIGINS=https://tendoriq.com,https://app.tendoriq.com
API_PREFIX=/api/v1

# ===========================================
# FRONTEND - Next.js (Vercel)
# ===========================================
NEXT_PUBLIC_APP_URL=https://tendoriq.com
NEXT_PUBLIC_API_URL=https://api.tendoriq.com
NEXT_PUBLIC_APP_NAME=TenderIQ

# ===========================================
# STORAGE - Cloudflare R2 (Production)
# ===========================================
STORAGE_PROVIDER=r2
AWS_REGION=auto
AWS_S3_BUCKET=tendoriq-prod
AWS_ACCESS_KEY_ID=${R2_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${R2_SECRET_ACCESS_KEY}
AWS_ENDPOINT_URL=${R2_ENDPOINT_URL}

# ===========================================
# AI - OpenAI (Production)
# ===========================================
AI_PROVIDER=openai
AI_API_KEY=${OPENAI_API_KEY}
AI_MODEL=gpt-4-turbo-preview
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7

# ===========================================
# EMAIL - Resend (Production)
# ===========================================
EMAIL_PROVIDER=resend
EMAIL_API_KEY=${RESEND_API_KEY}
EMAIL_FROM=noreply@tendoriq.com
EMAIL_FROM_NAME=TenderIQ

# ===========================================
# OBSERVABILITY - Sentry
# ===========================================
SENTRY_DSN=${SENTRY_DSN}
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILING_SAMPLE_RATE=0.01

# ===========================================
# RATE LIMITING - Strict in Production
# ===========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=500

# ===========================================
# FEATURE FLAGS
# ===========================================
FEATURE_AI_ANALYSIS=true
FEATURE_DOCUMENT_OCR=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_WEBHOOKS=true
FEATURE_API_ACCESS=true
FEATURE_CUSTOM_DOMAINS=true
FEATURE_SSO=true

# ===========================================
# SECURITY
# ===========================================
INTERNAL_API_KEY=${INTERNAL_API_KEY}
ENCRYPTION_KEY=${ENCRYPTION_KEY}