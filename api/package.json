{
  "name": "@tendoriq/api",
  "version": "1.0.0",
  "description": "FastAPI backend. Python deps: requirements-dev.txt (venv) — same as CI setup-api-python action.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "fastapi dev src/main.py --reload",
    "dev:debug": "fastapi dev src/main.py --reload --log-level debug",
    "start": "fastapi run src/main.py",
    "lint": "ruff check src/",
    "lint:fix": "ruff check src/ --fix",
    "format": "ruff format src/",
    "typecheck": "mypy src/",
    "test": "pytest",
    "test:unit": "pytest tests/unit tests/integration -q",
    "test:cov": "pytest --cov=src --cov-report=term-missing",
    "db:migrate": "alembic upgrade head",
    "db:current": "alembic current",
    "clean": "node -e \"['dist','.pytest_cache','.ruff_cache','coverage.xml'].forEach(d=>require('fs').rmSync(d,{recursive:true,force:true}))\""
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
