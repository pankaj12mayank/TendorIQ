{
  "name": "tenderiq",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "node scripts/dev.js",
    "dev:api": "node -e \"const{spawn}=require('child_process');const p=spawn(process.platform==='win32'?'api/venv/Scripts/python.exe':'api/venv/bin/python',['-m','uvicorn','src.main:app','--reload','--port','8000'],{cwd:'api',stdio:'inherit',shell:true});p.on('exit',c=>process.exit(c))\"",
    "dev:web": "cd web && pnpm dev",
    "migrate": "cd api && alembic upgrade head",
    "test:api": "cd api && pytest tests/unit -q",
    "stop": "taskkill /F /IM python.exe 2>nul & taskkill /F /IM node.exe 2>nul"
  },
  "devDependencies": {}
}
