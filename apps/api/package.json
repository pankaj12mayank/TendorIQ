{
  "name": "@tendoriq/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "fastapi dev src/main.py --reload",
    "dev:debug": "fastapi dev src/main.py --reload --log-level debug",
    "start": "fastapi run src/main.py",
    "build": "python -m py_compile src -o dist/",
    "lint": "ruff check src/",
    "lint:fix": "ruff check src/ --fix",
    "format": "ruff format src/",
    "typecheck": "mypy src/",
    "test": "pytest",
    "test:cov": "pytest --cov=src --cov-report=term-missing",
    "clean": "rm -rf dist/ .pytest_cache/ .ruff_cache/ coverage.xml"
  },
  "dependencies": {
    "@tendoriq/shared": "workspace:*",
    "fastapi": "^0.115.6",
    "uvicorn": "^0.34.0",
    "pydantic": "^2.10.5",
    "pydantic-settings": "^2.7.1",
    "sqlalchemy": "^2.0.36",
    "aiomysql": "^0.2.0",
    "PyMySQL": "^1.1.1",
    "alembic": "^1.14.0",
    "python-jose": "^3.3.0",
    "passlib": "^1.7.4",
    "bcrypt": "^4.2.1",
    "httpx": "^0.28.1",
    "sentry-sdk": "^2.22.0",
    "structlog": "^24.2.0",
    "python-json-logger": "^2.0.7",
    "python-multipart": "^0.0.20",
    "aiofiles": "^24.1.0",
    "boto3": "^1.35.0",
    "paddleocr": "^2.9.1",
    "paddlepaddle": "^3.0.0",
    "pdf2image": "^1.17.0",
    "Pillow": "^10.4.0",
    "opencv-python-headless": "^4.10.0",
    "numpy": "^1.26.0",
    "scipy": "^1.14.0",
    "PyMuPDF": "^1.24.0",
    "python-docx": "^1.1.0",
    "pypdf": "^5.0.0",
    "reportlab": "^4.2.5"
  },
  "devDependencies": {
    "fastapi-cli": "^0.0.5",
    "ruff": "^0.9.4",
    "mypy": "^1.14.0",
    "pytest": "^8.3.4",
    "pytest-asyncio": "^0.25.2",
    "pytest-cov": "^6.0.0",
    "httpx": "^0.28.1"
  }
}
