# ===========================================
# TENDERIQ - DEVELOPMENT ENVIRONMENT
# ===========================================
# Copy to .env and update values

# ===========================================
# APP
# ===========================================
NODE_ENV=development
LOG_LEVEL=debug
APP_NAME=TenderIQ
APP_URL=http://localhost:3000

# ===========================================
# DATABASE - PostgreSQL
# ===========================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=tendoriq
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tendoriq
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# ===========================================
# REDIS
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ===========================================
# AUTH - Clerk
# ===========================================
AUTH_PROVIDER=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# JWT
JWT_SECRET=dev-secret-min-32-chars-xxxxxxxxxxxxxx
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# API - FastAPI
# ===========================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=1
API_CORS_ORIGINS=http://localhost:3000
API_PREFIX=/api/v1

# ===========================================
# FRONTEND - Next.js
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=TenderIQ

# ===========================================
# STORAGE - Cloudflare R2 (recommended for production)
# ===========================================
STORAGE_PROVIDER=r2
AWS_REGION=auto
AWS_S3_BUCKET=tendoriq-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=https://abc123.r2.cloudflarestorage.com

# Cloudflare R2 specific
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key

# Storage settings
STORAGE_SIGNED_URL_EXPIRE_SECONDS=3600
STORAGE_MAX_FILE_SIZE_MB=50
STORAGE_ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.gif,.txt,.csv

# ===========================================
# AI - OpenAI
# ===========================================
AI_PROVIDER=openai
AI_API_KEY=sk-test-xxxxxxxxxxxxx
AI_MODEL=gpt-4
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7

# ===========================================
# EMAIL - Resend
# ===========================================
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=noreply@localhost
EMAIL_FROM_NAME=TenderIQ Dev

# ===========================================
# OBSERVABILITY - Sentry
# ===========================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILING_SAMPLE_RATE=0

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ===========================================
# FEATURE FLAGS
# ===========================================
FEATURE_AI_ANALYSIS=true
FEATURE_DOCUMENT_OCR=false
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_WEBHOOKS=true
FEATURE_API_ACCESS=true
FEATURE_CUSTOM_DOMAINS=false
FEATURE_SSO=false