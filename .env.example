# =============================================================================
# TenderIQ — environment template
# =============================================================================
# Setup:  copy .env.example .env   (or run.bat creates .env on first start)
# Auth:   database email/password (AUTH_PROVIDER=local)
# Docs:    docs/LOCAL_SETUP.md
# Owner:   after first start → .tenderiq/owner-account.txt
# =============================================================================

# --- Auth (default: local database login) ---
AUTH_PROVIDER=local
NEXT_PUBLIC_AUTH_PROVIDER=local

# --- First-time seed only (login always uses DB password_hash, not .env) ---
SYSTEM_OWNER_EMAIL=admin@tendoriq.com
SYSTEM_OWNER_DEFAULT_PASSWORD=Owner@ChangeMe123
SYSTEM_OWNER_NAME=System Owner
# --- Security (required — change before production) ---
JWT_SECRET=change-me-minimum-32-characters-long
ENCRYPTION_KEY=change-me-encryption-key-32-chars-min

# --- App / URLs ---
NODE_ENV=development
LOG_LEVEL=INFO
APP_NAME=TenderIQ
VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
RELOAD=true
WORKERS=1
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (SQLite default for local dev) ---
DATABASE_DRIVER=sqlite
# SQLITE_PATH=   # optional; default .tenderiq/data/tenderiq.db

# MySQL (production or advanced local):
# DATABASE_DRIVER=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=tenderiq

# --- CORS / errors ---
CORS_ORIGINS=http://localhost:3000
EXPOSE_ERROR_DETAILS=false

# --- Storage (local disk default) ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_BUCKET=tenderiq-uploads
STORAGE_MAX_FILE_SIZE_MB=25
STORAGE_ALLOWED_EXTENSIONS=.pdf,.doc,.docx

# Cloudflare R2 / S3 (optional):
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT_URL=

# --- AI (optional — at least one key for document analysis) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini
AI_AUTO_ANALYZE_ON_UPLOAD=true

# --- Export ---
LITE_EXPORT_PDF_ONLY=true

# --- Payments / billing (optional — Razorpay for plan upgrades) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR
# Local dev: false = only monthly quotas, no "plan expired" lock (production: true)
BILLING_ENFORCE_SUBSCRIPTION_EXPIRY=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Feature flags ---
FEATURE_AI_ANALYSIS=true
FEATURE_DOCUMENT_OCR=false
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_SSO=false
NEXT_PUBLIC_FEATURE_AI_ANALYSIS=true
NEXT_PUBLIC_FEATURE_DOCUMENT_OCR=false
NEXT_PUBLIC_FEATURE_ADVANCED_ANALYTICS=false
NEXT_PUBLIC_FEATURE_SSO=false

# --- Email (optional) ---
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=
# EMAIL_FROM=noreply@tendoriq.com

# --- Optional auth provider (not used in default local setup) ---
# Clerk: AUTH_PROVIDER=clerk + CLERK_SECRET_KEY + NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
