# TenderIQ — MySQL only, no Redis/Docker required

DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/tenderiq?charset=utf8mb4

# Auth (Clerk)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Security
JWT_SECRET=dev-secret-change-in-production-min-32-chars-long

# Payment (Super Admin)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
RAZORPAY_KEY_ID=razor_test_xxx
RAZORPAY_KEY_SECRET=razor_test_xxx

# AI (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# App
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads

# Super Admin
SUPER_ADMIN_EMAIL=admin@tenderiq.com
SUPER_ADMIN_PASSWORD=SuperAdmin@123
SUPER_ADMIN_API_KEY=tendersiq_super_admin_key_12345

# Email
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@tenderiq.com
