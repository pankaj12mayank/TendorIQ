# TenderIQ Environment Configuration

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tenderiq

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth (Clerk)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Security
SECRET_KEY=dev-secret-key-change-in-production

# Payment Gateways (Super Admin Configures)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
RAZORPAY_KEY_ID=razor_test_xxx
RAZORPAY_KEY_SECRET=razor_test_xxx

# AI Providers (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# App Settings
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads

# Super Admin Credentials (Direct Login)
SUPER_ADMIN_EMAIL=admin@tenderiq.com
SUPER_ADMIN_PASSWORD=SuperAdmin@123
SUPER_ADMIN_API_KEY=tendersiq_super_admin_key_12345

# Email (SMTP for invoices)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@tenderiq.com