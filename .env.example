# TenderIQ — local MySQL 8+ for dev (no Docker). Production: hosted MySQL URL on API host.
#
# 1. Copy this file to .env in the repo root:  copy .env.example .env
# 2. Database — sqlite (default, zero install) or mysql for production-like local dev
DATABASE_DRIVER=sqlite
# DATABASE_DRIVER=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=changeme
# MYSQL_DATABASE=tenderiq

# Auth (Clerk)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Security
JWT_SECRET=dev-secret-change-in-production-min-32-chars-long

# Payment (Super Admin)
# Stripe (primary — webhooks sync subscription at POST /api/v1/webhooks/stripe)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Razorpay (optional alternate checkout — see docs/billing-quota.md)
RAZORPAY_KEY_ID=razor_test_xxx
RAZORPAY_KEY_SECRET=razor_test_xxx

# AI (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# CORS (API — comma-separated; avoid * in production)
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept,X-Tenant-ID,X-Tenant-Slug,X-Request-ID
EXPOSE_ERROR_DETAILS=false

# Email system (transactional templates + queue; encrypts SMTP secrets at rest)
ENCRYPTION_KEY=dev-encryption-key-change-in-production-32b
EMAIL_PROVIDER=resend
# Required for Resend when not using Admin → Email System SMTP configs (or set RESEND_API_KEY)
EMAIL_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=noreply@tenderiq.com

# App
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature flags (web reads NEXT_PUBLIC_*; server FEATURE_* mirror when unset)
FEATURE_AI_ANALYSIS=true
FEATURE_DOCUMENT_OCR=false
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_SSO=false
NEXT_PUBLIC_FEATURE_AI_ANALYSIS=true
NEXT_PUBLIC_FEATURE_DOCUMENT_OCR=false
NEXT_PUBLIC_FEATURE_ADVANCED_ANALYTICS=false
NEXT_PUBLIC_FEATURE_SSO=false

# Storage (local: web uploads use POST /api/v1/files/upload/direct; presigned PUT is for s3/r2)
STORAGE_PROVIDER=local
# Relative paths resolve to apps/api/uploads (see settings.resolved_storage_local_path)
STORAGE_LOCAL_PATH=./uploads
STORAGE_TOKEN_CLOCK_SKEW_SECONDS=120
STORAGE_BUCKET=tendoriq-uploads
STORAGE_MAX_FILE_SIZE_MB=50
STORAGE_ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.gif,.txt,.csv
# S3/R2 (when STORAGE_PROVIDER=s3 or r2)
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_ENDPOINT_URL=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Unified login (email/password at /sign-in — role in JWT, no per-role API keys)
SUPER_ADMIN_EMAIL=admin@tenderiq.com
SUPER_ADMIN_PASSWORD=SuperAdmin@123

# Optional demo tenant (development)
DEMO_USER_EMAIL=demo@tenderiq.com
DEMO_USER_PASSWORD=Demo@123
DEMO_USER_ROLE=admin
DEMO_USER_NAME=Demo User

# Email (optional — configure Resend/SMTP in Super Admin → Email System instead)
# RESEND_API_KEY=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@tenderiq.com
