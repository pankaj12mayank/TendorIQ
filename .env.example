# =============================================================================
# TenderIQ — environment template
# =============================================================================
# Setup:  copy .env.example .env
# Local:  AUTH_PROVIDER=local + demo accounts below (no cloud keys)
# Guide:  docs/LOCAL_SETUP.md
# =============================================================================

# --- Auth mode: local | supabase | clerk ---
AUTH_PROVIDER=local
NEXT_PUBLIC_AUTH_PROVIDER=local

# --- Local login (API reads these when AUTH_PROVIDER=local) ---
SUPER_ADMIN_EMAIL=admin@tendoriq.com
SUPER_ADMIN_PASSWORD=change-me-super-admin-password
DEMO_USER_EMAIL=demo@tendoriq.com
DEMO_USER_PASSWORD=change-me-demo-password
DEMO_USER_ROLE=admin
DEMO_USER_NAME=Demo User

# --- Supabase (only if AUTH_PROVIDER=supabase) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Clerk (only if AUTH_PROVIDER=clerk) ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Security ---
JWT_SECRET=change-me-minimum-32-characters-long
ENCRYPTION_KEY=change-me-encryption-key-32-chars-min

# --- App / URLs ---
NODE_ENV=development
APP_NAME=TenderIQ
VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
RELOAD=true
WORKERS=1
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---
DATABASE_DRIVER=sqlite
# DATABASE_DRIVER=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=tenderiq

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
EXPOSE_ERROR_DETAILS=false

# --- Storage (local dev) ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_BUCKET=tendoriq-uploads
STORAGE_MAX_FILE_SIZE_MB=25
STORAGE_ALLOWED_EXTENSIONS=.pdf,.doc,.docx
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT_URL=

# --- AI (optional — at least one key for analysis) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini
AI_AUTO_ANALYZE_ON_UPLOAD=true

# --- Export ---
LITE_EXPORT_PDF_ONLY=true

# --- Payments (optional) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Feature flags ---
FEATURE_AI_ANALYSIS=true
FEATURE_DOCUMENT_OCR=false
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_SSO=false
NEXT_PUBLIC_FEATURE_AI_ANALYSIS=true
NEXT_PUBLIC_FEATURE_DOCUMENT_OCR=false
NEXT_PUBLIC_FEATURE_ADVANCED_ANALYTICS=false
NEXT_PUBLIC_FEATURE_SSO=false
